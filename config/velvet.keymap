#define BASE 0
#define SYMBOL 1
#define NUMBER 2
#define MOUSE 3

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <100>;
    };

    behaviors {
        opt_mt: opt_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "Optimized Mod-Tap";
            display-name = "Optimized Mod-Tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        opt_mt_2: opt_mt_2 {
            compatible = "zmk,behavior-hold-tap";
            label = "More Sensitive Optimized Mod-Tap";
            display-name = "More Sensitive Optimized Mod-Tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-on-release;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };

    combos {
        compatible = "zmk,combos";

        flash {
            bindings = <&bootloader>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
            &kp TAB              &kp Q                &kp W                &kp E                &kp R                &kp T                &kp C_NEXT           &kp Y                &kp U                &kp I                &kp O                &kp P                &kp LC(B)
            &kp CAPSLOCK         &opt_mt LCTRL A      &opt_mt_2 LSHIFT S   &opt_mt LGUI D       &opt_mt LALT F       &kp G                &kp C_PLAY_PAUSE     &kp H                &kp J                &kp K                &opt_mt_2 RSHIFT L   &kp SEMI             &kp SQT
            &kp LCTRL            &kp Z                &kp X                &kp C                &kp V                &kp B                &kp C_PREV           &kp N                &kp M                &kp COMMA            &kp DOT              &kp SLASH            &kp LCTRL
            &kp LALT             &kp LGUI             &mo SYMBOL           &kp SPACE            &kp ESC              &kp BSPC             &kp ENTER            &mo NUMBER           &kp UP               &kp DOWN
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
            &kp GRAVE          &kp LS(N1)         &kp LS(N2)         &kp LS(N3)         &kp LS(N4)         &kp LS(N5)         &trans             &kp LS(N6)         &kp LS(N7)         &kp LS(N8)         &kp LS(N9)         &kp LS(N0)         &kp DELETE
            &trans             &trans             &kp C_PREV         &kp C_PLAY_PAUSE   &kp C_NEXT         &trans             &trans             &kp MINUS          &kp EQUAL          &kp LBKT           &kp RBKT           &kp BSLH           &kp GRAVE
            &trans             &trans             &trans             &trans             &trans             &trans             &trans             &kp LS(MINUS)      &kp LS(EQUAL)      &kp LS(LBKT)       &kp LS(RBKT)       &kp LS(BSLH)       &kp LS(GRAVE)
            &trans             &trans             &trans             &trans             &kp SPACE          &kp BSPC           &trans             &trans             &kp HOME           &kp END
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
            &trans         &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &trans         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &trans
            &trans         &trans         &trans         &trans         &trans         &trans         &trans         &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans         &trans
            &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &kp KP_DOT     &trans         &trans
            &trans         &trans         &trans         &trans         &trans         &trans         &bt BT_SEL 0   &bt BT_SEL 1   &kp HOME       &kp END
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
            &trans       &trans       &trans       &trans       &trans       &trans       &trans       &mkp LCLK    &mkp RCLK    &trans       &trans       &trans       &trans
            &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &mkp LCLK    &mkp MCLK    &mkp RCLK    &trans       &trans
            &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans       &trans       &mo SYMBOL   &trans       &trans       &trans       &trans       &trans       &trans       &trans
            >;

            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        layer_4 {
            display-name = "Layer 4";
            bindings = <
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_5 {
            display-name = "Layer 5";
            bindings = <
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_6 {
            display-name = "Layer 6";
            bindings = <
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_7 {
            display-name = "Layer 7";
            bindings = <
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
